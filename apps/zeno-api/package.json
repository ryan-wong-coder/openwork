{
  "name": "@zeno/api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts src/admin.ts --target=bun --outdir dist",
    "start": "bun src/main.ts",
    "admin": "bun src/admin.ts",
    "test": "bun test --timeout 30000 test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openwork/features": "workspace:*",
    "@zeno/core": "workspace:*",
    "better-auth": "1.7.0-beta.10",
    "drizzle-orm": "0.45.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "typescript": "^5.9.3"
  }
}
